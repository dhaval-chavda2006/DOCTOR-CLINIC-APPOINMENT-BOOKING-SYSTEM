<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CareClinic</title>

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(to bottom right, #f1f5f9, #dbeafe, #c7d2fe);
    }
</style>
</head>

<body class="flex items-center justify-center min-h-screen">

<div class="container">

    <div class="card">

        <!-- LEFT -->
        <div class="left">
            <h1>Care<span>Clinic</span></h1>

            <p>
                Smart healthcare starts here. Book appointments and manage records easily.
            </p>

            <a href="login_patient.html" class="btn primary">Patient Login</a>
            <a href="login_doctor.html" class="btn secondary">Doctor Login</a>
        </div>

        <!-- RIGHT -->
        <div class="right">
            <h2>Simplify Clinic Operations</h2>

            <p>
                Manage appointments, reduce waiting time, and keep patient records organized.
            </p>

            <small>Secure • Reliable • Easy</small>
        </div>

    </div>

</div>

<style>
.container {
    width: 90%;
    max-width: 900px;
}

.card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: rgba(255,255,255,0.8);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

/* LEFT */
.left {
    padding: 40px;
}

.left h1 {
    font-size: 32px;
    font-weight: 700;
}

.left h1 span {
    color: #4f46e5;
}

.left p {
    margin: 15px 0 30px;
    color: #555;
}

/* BUTTONS */
.btn {
    display: block;
    text-align: center;
    padding: 12px;
    margin-bottom: 10px;
    border-radius: 10px;
    font-weight: 600;
    transition: 0.3s;
}

.primary {
    background: #4f46e5;
    color: white;
}

.primary:hover {
    background: #4338ca;
}

.secondary {
    border: 1px solid #ccc;
}

.secondary:hover {
    border-color: #4f46e5;
    color: #4f46e5;
}

/* RIGHT */
.right {
    background: linear-gradient(to bottom right, #4f46e5, #3b82f6);
    color: white;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.right h2 {
    font-size: 24px;
    font-weight: 600;
}

.right p {
    margin: 15px 0;
    font-size: 14px;
}

.right small {
    opacity: 0.8;
}

@media(max-width: 768px) {
    .card {
        grid-template-columns: 1fr;
    }
}
</style>

</body>
</html>
