<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CareClinic</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <div class="flex-center py-4">
        <div class="container" style="max-width: 900px;">
            <div class="card grid-2" style="padding: 0; overflow: hidden; border: none;">

                <!-- LEFT -->
                <div style="padding: 3rem;">
                    <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Care<span
                            style="color: var(--primary);">Clinic</span></h1>
                    <p style="margin-bottom: 2rem;">Smart healthcare starts here. Book appointments and manage records
                        easily.</p>

                    <div class="form-group">
                        <a href="login_patient.html" class="btn btn-primary btn-block">Patient Login</a>
                    </div>
                    <div class="form-group">
                        <a href="login_doctor.html" class="btn btn-outline btn-block">Doctor Login</a>
                    </div>
                </div>

                <!-- RIGHT -->
                <div
                    style="background: linear-gradient(to bottom right, var(--primary), #3b82f6); color: white; padding: 3rem; display: flex; flex-direction: column; justify-content: center;">
                    <h2 style="color: white; margin-bottom: 1rem;">Simplify Clinic Operations</h2>
                    <p style="color: rgba(255,255,255,0.9); margin-bottom: 2rem;">Manage appointments, reduce waiting
                        time, and keep patient records organized.</p>
                    <small style="color: rgba(255,255,255,0.7);">Secure • Reliable • Easy</small>
                </div>

            </div>
        </div>
    </div>

</body>

</html>
